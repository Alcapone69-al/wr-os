rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A app usa uma única conta da oficina (Firebase Auth).
    match /os/{id}        { allow read, write: if request.auth != null; }
    match /estoque/{id}   { allow read, write: if request.auth != null; }
    match /fotos/{id}     { allow read, write: if request.auth != null; }
    match /config/{id}    { allow read, write: if request.auth != null; }
    match /dispositivos/{id} { allow read, write: if request.auth != null; }
    // avisos_enviados só é escrito pelo servidor (conta de serviço ignora estas regras).
    match /{document=**}  { allow read, write: if false; }
  }
}
