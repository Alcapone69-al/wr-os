rules_version = '2';
/* Regras publicadas no projeto wr-oficina.
   A app usa uma única conta da oficina (Firebase Auth), por isso só esse e-mail
   lê e escreve — inclui os/estoque/fotos/config/dispositivos/avisos_enviados.
   O envio automático de avisos (GitHub Actions) usa a conta de serviço, que
   ignora estas regras, por isso continua a funcionar.
   Se um dia houver um login por oficina, troque a condição do e-mail. */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'yfxx258@gmail.com';
    }
  }
}
